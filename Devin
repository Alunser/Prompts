csharpnamespace UA2.Consorcio.Application.Services;

public class ContabilizacaoDisponibilizacaoService : IContabilizacaoDisponibilizacaoService
{
    private readonly IContabilizacaoFluirRepository _contabilizacaoFluirRepository;
    private readonly ICotaRepository                _cotaRepository;
    private readonly IGrupoRepository               _grupoRepository;
    private readonly IProcessoContabilizacaoService _processoContabilizacaoService;
    private readonly ILogger<ContabilizacaoDisponibilizacaoService> _logger;

    public ContabilizacaoDisponibilizacaoService(
        IContabilizacaoFluirRepository contabilizacaoFluirRepository,
        ICotaRepository                cotaRepository,
        IGrupoRepository               grupoRepository,
        IProcessoContabilizacaoService processoContabilizacaoService,
        ILogger<ContabilizacaoDisponibilizacaoService> logger)
    {
        _contabilizacaoFluirRepository = contabilizacaoFluirRepository;
        _cotaRepository                = cotaRepository;
        _grupoRepository               = grupoRepository;
        _processoContabilizacaoService = processoContabilizacaoService;
        _logger                        = logger;
    }

    public async Task ProcessarAsync(
        Guid loteId,
        DateTime dataBatch,
        DateTime dataProcessamento,
        int totalRegistro,
        CancellationToken cancellationToken)
    {
        // Lógica IDÊNTICA ao while(true) existente nos handlers
        long ultimoIdEvento = 0;

        while (true)
        {
            _logger.LogInformation(
                "CONSULTA_REALIZADA | Fluxo=Processar | UltimoIdEvento={UltimoIdEvento}",
                ultimoIdEvento);

            var contabilizacaoFluirList = await _contabilizacaoFluirRepository
                .ObterPorAsync(dataProcessamento, ultimoIdEvento);

            if (contabilizacaoFluirList == null || !contabilizacaoFluirList.Any())
                break;

            ultimoIdEvento = contabilizacaoFluirList.Last().IdEvento;

            var idCotaSet  = contabilizacaoFluirList.Select(x => x.IdCota).Distinct().ToArray();
            var idGrupoSet = contabilizacaoFluirList.Select(x => x.IdGrupo).Distinct().ToArray();

            var taskCota  = _cotaRepository.ObterPorAsync(idCotaSet);
            var taskGrupo = _grupoRepository.ObterPorAsync(idGrupoSet);
            await Task.WhenAll(taskCota, taskGrupo);

            var cotaList = (await taskCota)
                .GroupBy(x => x.IdCota)
                .ToDictionary(g => g.Key, g => g.First());

            var grupoList = (await taskGrupo)
                .GroupBy(x => x.IdGrupo)
                .ToDictionary(g => g.Key, g => g.First());

            var eventoContabilizacaoList = contabilizacaoFluirList
                .AsParallel()
                .WithDegreeOfParallelism(10)
                .Select(evento =>
                {
                    var cotaDto  = cotaList.TryGetValue(evento.IdCota,   out var cota)  ? cota  : null;
                    var grupoDto = grupoList.TryGetValue(evento.IdGrupo, out var grupo) ? grupo : null;
                    return EventoContabilizacaoWrapper.Criar(evento, cotaDto, grupoDto);
                })
                .ToList();

            var lote = new LoteWrapper(loteId, dataBatch, totalRegistro);
            foreach (var eventoContabil in eventoContabilizacaoList)
                lote.AdicionarEventoContabilizacao(eventoContabil);

            await _processoContabilizacaoService
                .PublicarContabilizacaoAsync(lote, cancellationToken);
        }
    }
}

