### repositories/lote_repository.py
Implementar os seguintes métodos:

- buscar_total_esperado(lote_id: str) -> int
  → SELECT QTD_TOTL
    FROM CTRL_LOTE_MOVI_CTB
    WHERE COD_UNIC_LOTE = :lote_id

- contar_movimentos(lote_id: str) -> int
  → SELECT COUNT(*)
    FROM SALD_CONT_CTBL_MLTO
    WHERE COD_UNIC = :lote_id

- atualizar_status(lote_id: str, status: CodProcessamento) -> None
  → UPDATE CTRL_LOTE_MOVI_CTB
    SET COD_PSST = :status,
        DAT_ATUI = NOW()
    WHERE COD_UNIC_LOTE = :lote_id

### services/lote_service.py
```python
class LoteService:
    def __init__(
        self,
        repo: LoteRepository,
        contabilizacoes_client: ContabilizacoesClient,
    ):
        self.repo = repo
        self.contabilizacoes_client = contabilizacoes_client

    def processar(self, input_data: LoteInput) -> LoteResponse:

        if input_data.tipo == TipoProcessamento.REPROCESSAMENTO:
            logger.info(
                "Reprocessamento solicitado",
                extra={
                    "lote_id": input_data.lote_id,
                    "data_batch": input_data.data_batch,
                }
            )
            self.contabilizacoes_client.reprocessar(
                lote_id=input_data.lote_id,
                data_batch=input_data.data_batch,
            )

        total_esperado = self.repo.buscar_total_esperado(
            input_data.lote_id
        )
        total_inserido = self.repo.contar_movimentos(
            input_data.lote_id
        )

        logger.info(
            "Verificando contagem do lote",
            extra={
                "lote_id": input_data.lote_id,
                "data_batch": input_data.data_batch,
                "total_esperado": total_esperado,
                "total_inserido": total_inserido,
            }
        )

        if total_inserido == total_esperado:
            self.repo.atualizar_status(
                input_data.lote_id,
                CodProcessamento.VALIDACAO_COM_SUCESSO,
            )
            return LoteResponse(
                status=StatusProcessamento.VALIDACAO_COM_SUCESSO,
                lote_id=input_data.lote_id,
            )

        self.repo.atualizar_status(
            input_data.lote_id,
            CodProcessamento.VALIDACAO_COM_FALHA,
        )
        return LoteResponse(
            status=StatusProcessamento.VALIDACAO_COM_FALHA,
            lote_id=input_data.lote_id,
        )
```

