public async Task<List<VwTaAclCobrancasAvulsas>> GetCobrancasAvulsas(
    List<int> id_cota,
    int numPage,
    int sizePage,
    List<int>? codigosMovimento = null,
    bool excluirCodigos = false)
{
    var query = _dbContext.VwTaAclCobrancasAvulsas
        .Where(_ => id_cota.Contains(_.IdCota))
        .AsQueryable();

    if (codigosMovimento != null && codigosMovimento.Any())
    {
        var idsComMovimento = await _dbContext.VwTaAclCobrancaAvulsaDetalhes
            .Where(d => excluirCodigos
                ? !codigosMovimento.Contains(d.IdCdMovtoFin)
                :  codigosMovimento.Contains(d.IdCdMovtoFin))
            .Select(d => d.IdConfi008)
            .Distinct()
            .ToListAsync();

        query = query.Where(_ => idsComMovimento.Contains(_.IdConfi008));
    }

    return await query
        .OrderBy(_ => _.IdCota)
        .Skip((numPage - 1) * sizePage)
        .Take(sizePage)
        .AsNoTracking()
        .ToListAsync();
}
