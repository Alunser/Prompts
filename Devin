## Implementação

O ContabilizacoesClient já existe no projeto em:
src/clients/external/contabilizacoes_client.py

Adicionar o método reprocessar() seguindo o padrão
já existente no arquivo:

```python
def reprocessar(self, lote_id: str, data_batch: str) -> None:
    token = self.sts_client.get_token()

    url = f"{self.base_url}/v1/contabilizacoes-contabeis"

    payload = {
        "lote_id": lote_id,
        "data_batch": data_batch,
    }

    headers = {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
    }

    logger.info(
        "Chamando API de reprocessamento",
        extra={
            "lote_id": lote_id,
            "data_batch": data_batch,
            "url": url,
        },
    )

    response = self.session.post(
        url,
        json=payload,
        headers=headers,
    )

    if response.status_code == 422:
        logger.warning(
            "API retornou erro de negocio",
            extra={
                "lote_id": lote_id,
                "data_batch": data_batch,
                "status_code": response.status_code,
                "response": response.text,
            },
        )
        return

    if not response.ok:
        logger.error(
            "Erro ao chamar API de reprocessamento",
            extra={
                "lote_id": lote_id,
                "data_batch": data_batch,
                "status_code": response.status_code,
                "response": response.text,
            },
        )
        raise Exception(
            f"Erro ao reprocessar lote {lote_id}. "
            f"Status: {response.status_code}. "
            f"Response: {response.text}"
        )

    logger.info(
        "API de reprocessamento chamada com sucesso",
        extra={
            "lote_id": lote_id,
            "data_batch": data_batch,
            "status_code": response.status_code,
        },
    )
```

