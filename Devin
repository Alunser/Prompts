app/src/clients/aws/rds_client.py

pythonimport logging
import pymysql
import pymysql.cursors

from src.clients.aws.secret_manager_client import SecretManagerClient
from src.utils.constants import RDS_SERVER, RDS_DATABASE, RDS_USERNAME, RDS_PASSWORD
from src.utils.endpoint_parser import parse_endpoint, InvalidEndpointError

logger = logging.getLogger(__name__)


class RdsClient:
    """
    Camada de conexão com o RDS MySQL.
    Busca credenciais via SecretManagerClient (com cache).
    Lazy connection — só conecta quando get_connection() é chamado.
    """

    def __init__(self):
        # Busca os 3 secrets separados (padrão Itaú)
        rds_endpoint = SecretManagerClient.get_secret(RDS_SERVER)
        self.host, self.port = parse_endpoint(rds_endpoint, default_port=3306)
        self.database = RDS_DATABASE
        self.user = SecretManagerClient.get_secret(RDS_USERNAME)
        self.password = SecretManagerClient.get_secret(RDS_PASSWORD)
        self._connection = None

    def get_connection(self) -> pymysql.Connection:
        """
        Retorna conexão ativa. Reconecta se a conexão estiver fechada.
        Usa DictCursor para retornar dicionários em vez de tuplas.
        """
        if self._connection is None or not self._connection.open:
            try:
                self._connection = pymysql.connect(
                    host=self.host,
                    port=self.port,
                    user=self.user,
                    password=self.password,
                    database=self.database,
                    cursorclass=pymysql.cursors.DictCursor,
                    autocommit=False,
                )
                logger.info("Conexão RDS estabelecida com sucesso")
            except UnicodeError as e:
                logger.error("Erro de hostname inválido ao conectar ao RDS: %s", e)
                raise InvalidEndpointError(
                    f"Hostname inválido para conexão RDS: {self.host}"
                ) from e
        return self._connection

    def close(self) -> None:
        """Fecha a conexão se estiver aberta."""
        if self._connection and self._connection.open:
            self._connection.close()
            logger.info("Conexão RDS encerrada")


