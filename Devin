namespace FX9.ProcessaMovimentoContabil.Application.UseCases.Processadores;

public class MensagemProcessador : IMensagemProcessador
{
    private readonly ProcessarMovimentoContabilWorkerHandler _handler;
    private readonly IRetornoMovimentoContabilService _retornoMovimentoContabilService;
    private readonly IKafkaConsumerChannel _kafkaConsumerChannel;
    private readonly ILogger<MensagemProcessador> _logger;
    private readonly object _commitLock = new();

    public MensagemProcessador(
        ProcessarMovimentoContabilWorkerHandler handler,
        IRetornoMovimentoContabilService retornoMovimentoContabilService,
        IKafkaConsumerChannel kafkaConsumerChannel,
        ILogger<MensagemProcessador> logger)
    {
        _handler = handler;
        _retornoMovimentoContabilService = retornoMovimentoContabilService;
        _kafkaConsumerChannel = kafkaConsumerChannel;
        _logger = logger;
    }

    public async Task ProcessarAsync(
        ConsumeResult<string, RecebimentoMovimentoContabil> consumeResult,
        CancellationToken cancellationToken)
    {
        try
        {
            var retornosParaPublicar = new List<RetornoMovimentoContabil>();

            // ✅ Lógica existente — não alterar
            var resultado = await _handler.ProcessarMensagemIndividual(
                consumeResult,
                retornosParaPublicar,
                cancellationToken);

            await PublicarRetornosSeExistir(retornosParaPublicar);

            if (resultado.Success)
                CommitarMensagem(consumeResult);
            else
                LogarErroSemCommit(consumeResult);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex,
                "Erro inesperado ao processar mensagem. " +
                "Kafka irá reenviar automaticamente.");
        }
    }

    private async Task PublicarRetornosSeExistir(
        List<RetornoMovimentoContabil> retornosParaPublicar)
    {
        if (!retornosParaPublicar.Any()) return;

        var resultado = await _retornoMovimentoContabilService
            .PublicarEmLote(retornosParaPublicar);

        if (!resultado.Success)
            _logger.LogError("Erro ao publicar retornos em lote no Kafka.");
    }

    private void CommitarMensagem(
        ConsumeResult<string, RecebimentoMovimentoContabil> consumeResult)
    {
        lock (_commitLock)
        {
            _kafkaConsumerChannel.CommitarMensagem(consumeResult);
        }

        _logger.LogInformation("Mensagem processada e commitada com sucesso.");
    }

    private void LogarErroSemCommit(
        ConsumeResult<string, RecebimentoMovimentoContabil> consumeResult)
    {
        _logger.LogWarning(
            "Mensagem processada com erro. Kafka irá reenviar automaticamente. " +
            "Offset: {Offset} Partição: {Particao}",
            consumeResult.Offset,
            consumeResult.Partition);
    }
}

