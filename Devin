pythonfrom dataclasses import dataclass
from typing import Optional
from app.src.models.enums import TipoProcessamento

@dataclass
class LoteInput:
    lote_id: str
    tipo: TipoProcessamento
    ultimo_id: Optional[int] = None

    @classmethod
    def from_event(cls, event: dict) -> "LoteInput":
        lote_id = event.get("loteId")
        tipo_raw = event.get("tipo", "")

        if not lote_id:
            raise ValueError("Campo 'loteId' é obrigatório")

        try:
            tipo = TipoProcessamento(tipo_raw.lower())
        except ValueError:
            raise ValueError(
                f"Campo 'tipo' inválido: '{tipo_raw}'. Use 'envio' ou 'reprocessamento'"
            )

        return cls(
            lote_id=lote_id,
            tipo=tipo,
            ultimo_id=event.get("ultimo_id"),
        )
