pythonfrom unittest.mock import MagicMock
import pytest

from src.models.enums import TipoProcessamento, StatusProcessamento
from src.models.lote_input import LoteInput
from src.services.lote_service import LoteService


def make_input(tipo: TipoProcessamento, quantidade_total: int = 10) -> LoteInput:
    return LoteInput(
        lote_id="LOTE-001",
        data_batch="2026-06-18",
        quantidade_total=quantidade_total,
        tipo=tipo,
    )


@pytest.fixture
def service():
    repo = MagicMock()
    contabilizacoes_client = MagicMock()
    return LoteService(repo=repo, contabilizacoes_client=contabilizacoes_client)


def test_processar_tipo_validacao_chama_validar_lote(service):
    input_data = make_input(TipoProcessamento.VALIDACAO)
    service._validar_lote = MagicMock(return_value=MagicMock())
    service.processar(input_data)
    service._validar_lote.assert_called_once_with(input_data)


def test_processar_tipo_reprocessamento_chama_disparar(service):
    input_data = make_input(TipoProcessamento.REPROCESSAMENTO)
    service._disparar_reprocessamento = MagicMock(return_value=MagicMock())
    service.processar(input_data)
    service._disparar_reprocessamento.assert_called_once_with(input_data)


def test_validar_lote_sucesso(service):
    input_data = make_input(TipoProcessamento.VALIDACAO, quantidade_total=5)
    service.repo.buscar_total_esperado.return_value = 5
    service.repo.contar_movimentos.return_value = 5
    service.repo.atualizar_status.return_value = None
    result = service._validar_lote(input_data)
    assert result.status == StatusProcessamento.VALIDACAO_COM_SUCESSO.value


def test_validar_lote_falha_quantidade_banco_diverge(service):
    input_data = make_input(TipoProcessamento.VALIDACAO, quantidade_total=5)
    service.repo.buscar_total_esperado.return_value = 9999
    service.repo.contar_movimentos.return_value = 5
    service.repo.atualizar_status.return_value = None
    result = service._validar_lote(input_data)
    assert result.status == StatusProcessamento.VALIDACAO_COM_FALHA.value


def test_validar_lote_falha_total_inserido_diverge(service):
    input_data = make_input(TipoProcessamento.VALIDACAO, quantidade_total=5)
    service.repo.buscar_total_esperado.return_value = 5
    service.repo.contar_movimentos.return_value = 3
    service.repo.atualizar_status.return_value = None
    result = service._validar_lote(input_data)
    assert result.status == StatusProcessamento.VALIDACAO_COM_FALHA.value


def test_disparar_reprocessamento_retorna_aguardando(service):
    input_data = make_input(TipoProcessamento.REPROCESSAMENTO)
    service.repo.atualizar_status.return_value = None
    result = service._disparar_reprocessamento(input_data)
    service.contabilizacoes_client.reprocessar.assert_called_once_with(
        lote_id=input_data.lote_id,
        data_batch=input_data.data_batch,
    )
    assert result.status == StatusProcessamento.AGUARDANDO_REPROCESSAMENTO.value
