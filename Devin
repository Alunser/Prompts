namespace FX9.ProcessaMovimentoContabil.Infra.Messaging.Consumers;

public class KafkaMensagemProdutor : IKafkaMensagemProdutor
{
    private readonly IKafkaConsumerChannel _kafkaConsumerChannel;
    private readonly ILogger<KafkaMensagemProdutor> _logger;

    public KafkaMensagemProdutor(
        IKafkaConsumerChannel kafkaConsumerChannel,
        ILogger<KafkaMensagemProdutor> logger)
    {
        _kafkaConsumerChannel = kafkaConsumerChannel;
        _logger = logger;
    }

    public async Task ProduzirParaChannelAsync(
        ChannelWriter<ConsumeResult<string, RecebimentoMovimentoContabil>> channelWriter,
        CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                var mensagem = _kafkaConsumerChannel.Consumir(cancellationToken);

                if (mensagem is null) continue;

                await channelWriter.WriteAsync(mensagem, cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
            _logger.LogInformation("Leitura do Kafka encerrada.");
        }
        catch (ConsumeException ex)
        {
            _logger.LogError(ex, "Erro ao ler mensagem do Kafka.");
        }
        finally
        {
            channelWriter.Complete();
        }
    }
}

