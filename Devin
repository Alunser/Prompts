// Bypass para requests de autenticação
const url = bru.getEnvVar("__request_url") || "";
if (url.includes("/oauth/token") || url.includes("/token_info")) {
  return;
}

const https = require('https');
const axios = require('axios');
const fs = require('fs');

// Configuração do agente HTTPS com certificado corporativo
const ca = fs.readFileSync('C:\\Users\\UNSERAL\\certificados\\ca_interno_itau.cer');
const agent = new https.Agent({ ca });

const TOLERANCIA_MS = 30 * 1000;
const TOKEN_URL = bru.getEnvVar("auth_url");
const TOKEN_INFO_URL = `${TOKEN_URL}_info`;

// Configuração padrão do axios com agent e timeout
const axiosConfig = {
  headers: { "Content-Type": "application/x-www-form-urlencoded" },
  httpsAgent: agent,
  timeout: 10000 // 10 segundos
};

let accessToken = bru.getEnvVar("access_token");

async function generateNewToken() {
  const clientId = bru.getEnvVar("client_id");
  const clientSecret = bru.getEnvVar("client_secret");

  if (!clientId || !clientSecret || !TOKEN_URL) {
    throw new Error(`Variáveis ausentes — client_id: ${!!clientId}, client_secret: ${!!clientSecret}, auth_url: ${!!TOKEN_URL}`);
  }

  const requestBody = `client_id=${encodeURIComponent(clientId)}&client_secret=${encodeURIComponent(clientSecret)}&grant_type=client_credentials`;

  console.log("i Gerando novo token...");

  const response = await axios.post(TOKEN_URL, requestBody, axiosConfig);

  if (response.status !== 200) {
    throw new Error(`Status ${response.status}: ${JSON.stringify(response.data)}`);
  }

  const newToken = response.data.access_token;
  if (!newToken) throw new Error("Resposta sem access_token");

  bru.setEnvVar("access_token", newToken);
  console.log("✓ Token gerado com sucesso");
  return newToken;
}

async function validateToken(token) {
  try {
    const response = await axios.post(
      `${TOKEN_INFO_URL}?token=${token}`,
      "",
      axiosConfig
    );

    if (response.status !== 200) return false;

    const { active, exp } = response.data;
    const tempoRestante = (Number(exp) * 1000) - Date.now();

    if (!active || tempoRestante <= TOLERANCIA_MS) {
      console.log(`△ Token expirando em ${Math.round(tempoRestante / 1000)}s. Renovando...`);
      return false;
    }

    console.log(`✓ Token válido (${Math.round(tempoRestante / 1000)}s restantes)`);
    return true;
  } catch (error) {
    console.log(`△ Erro ao validar token: ${error.message}. Renovando...`);
    return false;
  }
}

async function ensureValidToken() {
  try {
    if (!accessToken || !(await validateToken(accessToken))) {
      accessToken = await generateNewToken();
    }
  } catch (error) {
    console.error("✗ Falha ao obter token:", error.message);
    throw error;
  }
}

await ensureValidToken();
