pythonimport json
import logging
import os
import boto3

logger = logging.getLogger(__name__)

AWS_REGION = os.environ.get("AWS_REGION", "sa-east-1")


class SecretManagerClient:
    """
    Encapsula busca de secrets no AWS Secrets Manager.
    Cache em memória evita múltiplas chamadas para o mesmo secret
    durante a mesma execução da Lambda.
    """
    _cache: dict = {}

    @staticmethod
    def get_secret(secret_name: str) -> dict:
        if secret_name in SecretManagerClient._cache:
            logger.debug("Secret obtido do cache: %s", secret_name)
            return SecretManagerClient._cache[secret_name]

        logger.info("Buscando secret: %s", secret_name)
        region_name = os.getenv("AWS_REGION", AWS_REGION)
        client = boto3.client("secretsmanager", region_name=region_name)

        try:
            response = client.get_secret_value(SecretId=secret_name)
            logger.info("Secret obtido com sucesso")

            if "SecretString" in response:
                secret = response["SecretString"]
                logger.debug("Secret é do tipo SecretString")
            else:
                secret = response["SecretBinary"].decode("utf-8")
                logger.debug("Secret é do tipo SecretBinary")

            try:
                result = json.loads(secret)
                logger.debug("Secret parseado como JSON com sucesso")
            except json.JSONDecodeError:
                result = secret
                logger.debug("Secret não é JSON, retornando como string")

            SecretManagerClient._cache[secret_name] = result
            return result

        except Exception as e:
            logger.error("Erro ao buscar secret %s: %s", secret_name, e)
            raise
