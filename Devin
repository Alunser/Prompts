namespace FX9.ProcessaMovimentoContabil.Worker.Workers;

public class ProcessarMovimentoContabilWorker : BackgroundService
{
    private readonly IKafkaConsumerChannel _kafkaConsumerChannel;
    private readonly IMensagemProcessador _mensagemProcessador;
    private readonly KafkaConfiguration _kafkaConfiguration;
    private readonly WorkerConfiguration _workerConfiguration;
    private readonly ILogger<ProcessarMovimentoContabilWorker> _logger;

    public ProcessarMovimentoContabilWorker(
        IKafkaConsumerChannel kafkaConsumerChannel,
        IMensagemProcessador mensagemProcessador,
        KafkaConfiguration kafkaConfiguration,
        WorkerConfiguration workerConfiguration,
        ILogger<ProcessarMovimentoContabilWorker> logger)
    {
        _kafkaConsumerChannel = kafkaConsumerChannel;
        _mensagemProcessador = mensagemProcessador;
        _kafkaConfiguration = kafkaConfiguration;
        _workerConfiguration = workerConfiguration;
        _logger = logger;
    }

    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
    {
        var topicConfiguration = ObterConfiguracaoTopico();

        if (topicConfiguration is null || !topicConfiguration.Enable)
        {
            _logger.LogWarning(
                "Configuração do tópico não habilitada ou não encontrada.");
            return;
        }

        _kafkaConsumerChannel.Inicializar(topicConfiguration.Name);

        _logger.LogInformation(
            "Worker iniciado. Tópico: {Topico}. Workers paralelos: {Workers}",
            topicConfiguration.Name,
            _workerConfiguration.ParallelWorkers);

        var channel = Channel
            .CreateBounded<ConsumeResult<string, RecebimentoMovimentoContabil>>(
                new BoundedChannelOptions(_workerConfiguration.ChannelCapacity)
                {
                    FullMode = BoundedChannelFullMode.Wait,
                    SingleWriter = true,
                    SingleReader = false
                });

        await ExecutarProducaoEProcessamentoAsync(channel, stoppingToken);

        _kafkaConsumerChannel.Encerrar();

        _logger.LogInformation("Worker encerrado.");
    }

    private async Task ExecutarProducaoEProcessamentoAsync(
        Channel<ConsumeResult<string, RecebimentoMovimentoContabil>> channel,
        CancellationToken stoppingToken)
    {
        var producaoTask = _kafkaConsumerChannel
            .ProduzirParaChannelAsync(channel.Writer, stoppingToken);

        var processamentoTasks = CriarWorkersDeProcessamento(
            channel.Reader, stoppingToken);

        await Task.WhenAll(new[] { producaoTask }.Concat(processamentoTasks));
    }

    private IEnumerable<Task> CriarWorkersDeProcessamento(
        ChannelReader<ConsumeResult<string, RecebimentoMovimentoContabil>> channelReader,
        CancellationToken stoppingToken)
        => Enumerable
            .Range(0, _workerConfiguration.ParallelWorkers)
            .Select(_ => Task.Run(
                async () => await ProcessarMensagensDoChannelAsync(
                    channelReader, stoppingToken),
                stoppingToken));

    private async Task ProcessarMensagensDoChannelAsync(
        ChannelReader<ConsumeResult<string, RecebimentoMovimentoContabil>> channelReader,
        CancellationToken stoppingToken)
    {
        await foreach (var mensagem in channelReader.ReadAllAsync(stoppingToken))
        {
            await _mensagemProcessador.ProcessarAsync(mensagem, stoppingToken);
        }
    }

    private TopicConfiguration ObterConfiguracaoTopico()
        => _kafkaConfiguration
            .ConsumerConfiguration
            .TopicConfigurations
            .FirstOrDefault(x => x.Tipo == ETipoTopico.RecebimentosMovimentoContabil);
}

