Título: Feat: Criar LogMovimentoContext para enriquecer logs com contexto do fluxo
Contexto:
Worker service FX9.ProcessaMovimentoContabil em .NET 8 com Serilog. Os logs chegam no Datadog sem contexto suficiente para rastreabilidade. O objetivo é que todo log do fluxo de processamento contenha automaticamente o CodigoIdentificacaoMovimentacaoFinanceira e outras propriedades chave, sem precisar passar manualmente em cada chamada de log.
Referência de implementação:
Baseado no padrão já usado no projeto UA2.Consorcio com a classe LogLoteContext.

Tarefa 1 — Criar a classe LogMovimentoContext.cs em FX9.ProcessaMovimentoContabil.Infra.Logging:
csharpusing Serilog.Context;

namespace FX9.ProcessaMovimentoContabil.Infra.Logging
{
    public sealed class LogMovimentoContext : IDisposable
    {
        private readonly IDisposable _codigoIdentificacao;
        private readonly IDisposable _codigoEmpresa;
        private readonly IDisposable _codigoReferencia;
        private readonly IDisposable _dataProcessamento;

        public LogMovimentoContext(
            string codigoIdentificacaoMovimentacaoFinanceira,
            string codigoEmpresa,
            string codigoIdentificadorReferenciaMovimento,
            DateTime? dataProcessamento = null)
        {
            _codigoIdentificacao = LogContext.PushProperty(
                "CodigoIdentificacaoMovimentacaoFinanceira", 
                codigoIdentificacaoMovimentacaoFinanceira);
            _codigoEmpresa       = LogContext.PushProperty("CodigoEmpresa", codigoEmpresa);
            _codigoReferencia    = LogContext.PushProperty(
                "CodigoIdentificadorReferenciaMovimento", 
                codigoIdentificadorReferenciaMovimento);
            _dataProcessamento   = LogContext.PushProperty(
                "DataProcessamento", 
                (dataProcessamento ?? DateTime.UtcNow).ToString("o"));
        }

        public void Dispose()
        {
            _codigoIdentificacao.Dispose();
            _codigoEmpresa.Dispose();
            _codigoReferencia.Dispose();
            _dataProcessamento.Dispose();
        }
    }
}

