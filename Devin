/// <summary>
/// Commita quando:
/// - Sucesso (200) — mensagem processada com êxito
/// - Erro de negócio permanente (422) — handler já gravou MovimentoErro no banco
///   e publicou retorno no Kafka. Sem commit geraria duplicatas no reprocessamento.
/// Não commita quando:
/// - Erro inesperado (500) — Kafka reenvia para nova tentativa
/// </summary>
private static bool DeveCommitar(ICommandResult resultado)
    => resultado.StatusCode == (int)HttpStatusCode.OK ||
       resultado.StatusCode == (int)HttpStatusCode.UnprocessableEntity;

private async Task PublicarRetornosSeExistir(
    List<RetornoMovimentoContabil> retornosParaPublicar)
{
    if (!retornosParaPublicar.Any()) return;

    var resultado = await _retornoMovimentoContabilService
        .PublicarEmLote(retornosParaPublicar);

    if (!resultado.Success)
        _logger.LogError("Erro ao publicar retornos em lote no Kafka.");
}

private void CommitarMensagem(
    ConsumeResult<string, RecebimentoMovimentoContabil> consumeResult)
{
    _kafkaConsumerChannel.CommitarMensagem(consumeResult);
    _logger.LogInformation("Mensagem processada e commitada com sucesso.");
}

private void LogarErroSemCommit(
    ConsumeResult<string, RecebimentoMovimentoContabil> consumeResult)
{
    _logger.LogWarning(
        "Erro inesperado no processamento. " +
        "Kafka irá reenviar automaticamente. " +
        "Offset: {Offset} Partição: {Particao}",
        consumeResult.Offset,
        consumeResult.Partition);
}

4. ProcessarMovimentoContabilWorker.cs — substituir completo
FX9.ProcessaMovimentoContabil.Worker/Workers/ProcessarMovimentoContabilWorker.cs
Substituir o conteúdo completo pelo código abaixo:
csharpnamespace FX9.ProcessaMovimentoContabil.Worker.Workers;

public class ProcessarMovimentoContabilWorker : BackgroundService
{
    private readonly IKafkaConsumerChannel _kafkaConsumerChannel;
    private readonly IMensagemProcessador _mensagemProcessador;
    private readonly KafkaConfiguration _kafkaConfiguration;
    private readonly ILogger<ProcessarMovimentoContabilWorker> _logger;

    public ProcessarMovimentoContabilWorker(
        IKafkaConsumerChannel kafkaConsumerChannel,
        IMensagemProcessador mensagemProcessador,
        KafkaConfiguration kafkaConfiguration,
        ILogger<ProcessarMovimentoContabilWorker> logger)
    {
        _kafkaConsumerChannel = kafkaConsumerChannel;
        _mensagemProcessador = mensagemProcessador;
        _kafkaConfiguration = kafkaConfiguration;
        _logger = logger;
    }

    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
    {
        var topicConfiguration = ObterConfiguracaoTopico();

        if (topicConfiguration is null || !topicConfiguration.Enable)
        {
            _logger.LogWarning(
                "Configuração do tópico não habilitada ou não encontrada.");
            return;
        }

        _kafkaConsumerChannel.Inicializar(topicConfiguration.Name);

        _logger.LogInformation(
            "Worker iniciado. Tópico: {Topico}",
            topicConfiguration.Name);

        try
        {
            await ConsumirMensagensAsync(stoppingToken);
        }
        finally
        {
            // Garante que o consumer sempre fecha corretamente
            // mesmo quando CancellationToken é cancelado
            _kafkaConsumerChannel.Encerrar();
            _logger.LogInformation("Worker encerrado.");
        }
    }

    private async Task ConsumirMensagensAsync(CancellationToken stoppingToken)
    {
        while (!stoppingToken.IsCancellationRequested)
        {
            try
            {
                var mensagem = _kafkaConsumerChannel.Consumir(stoppingToken);

                if (mensagem is null) continue;

                // Processamento sequencial — garante commit na ordem correta
                await _mensagemProcessador.ProcessarAsync(mensagem, stoppingToken);
            }
            catch (OperationCanceledException)
            {
                // Worker sendo encerrado — saída limpa
                break;
            }
            catch (ConsumeException ex)
                when (ex.Error.Code == ErrorCode.UnknownTopicOrPart)
            {
                // Metadados ainda não prontos — aguarda e tenta novamente
                _logger.LogWarning(
                    "Tópico ainda não disponível. " +
                    "Tentando novamente em 2 segundos.");

                await Task.Delay(2000, stoppingToken);
            }
            catch (ConsumeException ex)
            {
                // Erro de consumo — loga e continua o loop
                _logger.LogError(ex,
                    "Erro ao consumir mensagem do Kafka. Continuando...");
            }
        }
    }

    private TopicConfiguration ObterConfiguracaoTopico()
    {
        var configuracao = _kafkaConfiguration
            .ConsumerConfiguration
            .TopicConfigurations
            .FirstOrDefault(x => x.Tipo == ETipoTopico.RecebimentosMovimentoContabil);

        if (configuracao is null)
            _logger.LogError(
                "Configuração do tópico {Topico} não encontrada no appsettings.",
                ETipoTopico.RecebimentosMovimentoContabil);

        return configuracao;
    }
}

