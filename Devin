utils/endpoint_parser.py
pythonMAX_DNS_LABEL_LENGTH = 63

class InvalidEndpointError(Exception):
    """Exception raised when an endpoint is invalid."""
    pass

def validate_hostname(hostname: Optional[str]) -> None:
    if not hostname:
        return
    labels = hostname.split('.')
    for label in labels:
        if len(label) > MAX_DNS_LABEL_LENGTH:
            raise InvalidEndpointError(
                ERROR_INVALID_HOSTNAME.format(hostname=hostname)
            )

def parse_endpoint(endpoint: Optional[str], default_port: int) -> Tuple[Optional[str], int]:
    if endpoint and ':' in endpoint:
        parts = endpoint.rsplit(':', 1)
        host = parts[0]
        validate_hostname(host)
        return host, int(parts[1])
    validate_hostname(endpoint)
    return endpoint, default_port
