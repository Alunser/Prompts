    private readonly DbContext _dbContext;

    public CobrancasEmitidasRepository(DbContext dbContext)
        => _dbContext = dbContext;

    public async Task<int> GetCount(List<int> id_cota, short? parcela)
    {
        var query = _dbContext.VwTaAclRemessaMensalCota.AsQueryable();
        query = query.Where(_ => id_cota.Contains(_.IdCota));
        if (parcela.HasValue)
            query = query.Where(_ => _.NoParcela == parcela);
        return await query.AsNoTracking().CountAsync();
    }

