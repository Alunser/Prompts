8.1 — Remover TryPublishWithRetry e substituir por:

csharpprivate async Task<bool> TryPublishWithRetryAsync(
    IProducer<string, ContabilizacaoGerada> producer,
    string topicName,
    Message<string, ContabilizacaoGerada> message,
    long idEvento,
    CancellationToken cancellationToken)
{
    var enableRetry = _kafkaConfiguration.ProducerConfiguration.EnableRetry;
    var maxRetries  = enableRetry
        ? _kafkaConfiguration.ProducerConfiguration.MaxRetries
        : 1;

    for (var attempt = 1; attempt <= maxRetries; attempt++)
    {
        try
        {
            var result = await producer.ProduceAsync(topicName, message, cancellationToken);

            if (result.Status == PersistenceStatus.Persisted)
                return true;

            _logger.LogWarning(
                "RETRY_TENTATIVA | Fluxo=PublicacaoKafka | IdEvento={IdEvento} | Tentativa={Tentativa}/{Max} | Status={Status}",
                idEvento, attempt, maxRetries, result.Status);

            if (attempt == maxRetries)
                _logger.LogCritical(
                    "LOTE_ABORTADO | Fluxo=PublicacaoKafka | IdEvento={IdEvento} | Tentativas={Max} | Status={Status}",
                    idEvento, maxRetries, result.Status);
        }
        catch (Exception ex) when (ex is KafkaException
                                or AggregateException { InnerException: KafkaException })
        {
            _logger.LogWarning(ex,
                "RETRY_TENTATIVA | Fluxo=PublicacaoKafka | IdEvento={IdEvento} | Tentativa={Tentativa}/{Max}",
                idEvento, attempt, maxRetries);

            if (attempt == maxRetries)
                _logger.LogCritical(ex,
                    "LOTE_ABORTADO | Fluxo=PublicacaoKafka | IdEvento={IdEvento} | Tentativas={Max}",
                    idEvento, maxRetries);
        }
        catch (Exception ex)
        {
            _logger.LogCritical(ex,
                "FALHA_DEPENDENCIA | Fluxo=PublicacaoKafka | IdEvento={IdEvento}",
                idEvento);
            return false;
        }
    }

    return false;
}

