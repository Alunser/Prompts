Passo 5 — Criar ContabilizacaoDisponibilizacaoService.cs

csharpnamespace UA2.Consorcio.Application.Services;

public class ContabilizacaoDisponibilizacaoService : IContabilizacaoDisponibilizacaoService
{
    private const int ChunkSize      = 10_000;
    private const int MaxParalelismo = 4;

    private readonly IContabilizacaoFluirRepository    _contabilizacaoFluirRepository;
    private readonly ICotaRepository                   _cotaRepository;
    private readonly IGrupoRepository                  _grupoRepository;
    private readonly IProcessoContabilizacaoService    _processoContabilizacaoService;
    private readonly ILogger<ContabilizacaoDisponibilizacaoService> _logger;

    public ContabilizacaoDisponibilizacaoService(
        IContabilizacaoFluirRepository    contabilizacaoFluirRepository,
        ICotaRepository                   cotaRepository,
        IGrupoRepository                  grupoRepository,
        IProcessoContabilizacaoService    processoContabilizacaoService,
        ILogger<ContabilizacaoDisponibilizacaoService> logger)
    {
        _contabilizacaoFluirRepository = contabilizacaoFluirRepository;
        _cotaRepository                = cotaRepository;
        _grupoRepository               = grupoRepository;
        _processoContabilizacaoService = processoContabilizacaoService;
        _logger                        = logger;
    }

    public async Task ProcessarAsync(
        Guid loteId,
        string dataBatch,
        DateTime dataProcessamento,
        CancellationToken cancellationToken)
    {
        // 1. Busca total de registros do dia
        var totalRegistro = await _contabilizacaoFluirRepository
            .ObterTotalLinhasAsync(dataProcessamento);

        _logger.LogInformation(
            "CONSULTA_REALIZADA | Fluxo=Processar | TotalRegistros={TotalRegistros}",
            totalRegistro);

        if (totalRegistro == 0)
        {
            _logger.LogInformation("LOTE_CONCLUIDO | Fluxo=Processar | TotalRegistros=0");
            return;
        }

        // 2. Calcula total de chunks
        var totalChunks = (int)Math.Ceiling((double)totalRegistro / ChunkSize);

        _logger.LogInformation(
            "CHUNKS_CALCULADOS | TotalChunks={TotalChunks} | ChunkSize={ChunkSize}",
            totalChunks, ChunkSize);

        // 3. SemaphoreSlim garante no máximo 4 chunks simultâneos
        //    Conforme um termina, o próximo entra automaticamente
        var semaphore = new SemaphoreSlim(MaxParalelismo);

        var tasks = Enumerable.Range(0, totalChunks)
            .Select(chunkIndex => ProcessarChunkAsync(
                chunkIndex,
                dataProcessamento,
                dataBatch,
                loteId,
                totalRegistro,
                semaphore,
                cancellationToken));

        await Task.WhenAll(tasks);
    }

    private async Task ProcessarChunkAsync(
        int chunkIndex,
        DateTime dataProcessamento,
        string dataBatch,
        Guid loteId,
        int totalRegistro,
        SemaphoreSlim semaphore,
        CancellationToken cancellationToken)
    {
        await semaphore.WaitAsync(cancellationToken); // aguarda vaga disponível
        try
        {
            var offset = chunkIndex * ChunkSize;

            _logger.LogInformation(
                "CHUNK_INICIADO | ChunkIndex={ChunkIndex} | Offset={Offset}",
                chunkIndex, offset);

            // Busca página do banco via OFFSET
            var lista = (await _contabilizacaoFluirRepository.ObterPorOffsetAsync(
                dataProcessamento, offset, ChunkSize)).ToList();

            if (!lista.Any()) return;

            // Busca cotas e grupos em paralelo
            var idCotaSet  = lista.Select(x => x.IdCota).Distinct().ToArray();
            var idGrupoSet = lista.Select(x => x.IdGrupo).Distinct().ToArray();

            var taskCota  = _cotaRepository.ObterPorAsync(idCotaSet);
            var taskGrupo = _grupoRepository.ObterPorAsync(idGrupoSet);
            await Task.WhenAll(taskCota, taskGrupo);

            var cotaList  = (await taskCota)
                .GroupBy(x => x.IdCota).ToDictionary(g => g.Key, g => g.First());
            var grupoList = (await taskGrupo)
                .GroupBy(x => x.IdGrupo).ToDictionary(g => g.Key, g => g.First());

            // Monta eventos em paralelo
            var eventoContabilizacaoList = lista
                .AsParallel()
                .WithDegreeOfParallelism(10)
                .Select(evento => EventoContabilizacaoWrapper.Criar(
                    evento,
                    cotaList.TryGetValue(evento.IdCota,   out var cota)  ? cota  : null,
                    grupoList.TryGetValue(evento.IdGrupo, out var grupo) ? grupo : null))
                .ToList();

            // Monta lote e publica no Kafka
            var lote = new LoteWrapper(loteId, dataBatch, totalRegistro);
            foreach (var eventoContabil in eventoContabilizacaoList)
                lote.AdicionarEventoContabilizacao(eventoContabil);

            await _processoContabilizacaoService
                .PublicarContabilizacaoAsync(lote, cancellationToken);

            _logger.LogInformation(
                "CHUNK_CONCLUIDO | ChunkIndex={ChunkIndex} | Eventos={Eventos}",
                chunkIndex, eventoContabilizacaoList.Count);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex,
                "CHUNK_ERRO | ChunkIndex={ChunkIndex} | Erro={Erro}", chunkIndex, ex.Message);
            throw;
        }
        finally
        {
            semaphore.Release(); // libera vaga para o próximo chunk
        }
    }
}


