### 3. Facade — método privado GetTodos

```csharp
private async Task<List<CobrancasEmitidas>> GetTodos(
    GetCobrancasEmitidasRequest request, int numPage, int sizePage)
{
    // Busca sem paginação nas duas fontes
    var mensais = await GetMensaisSemPaginacao(request);
    var avulsas = await GetAvulsasSemPaginacao(request);

    // Pagina o conjunto combinado na memória
    return mensais
        .Concat(avulsas)
        .Skip((numPage - 1) * sizePage)
        .Take(sizePage)
        .ToList();
}

private async Task<List<CobrancasEmitidas>> GetMensaisSemPaginacao(
    GetCobrancasEmitidasRequest request)
{
    var remessaCota = await _repo.GetRemessaMensalCotaTodos(
        request.IdCota, request.Parcela);

    var idConco021A  = remessaCota.Select(_ => _.IdConco021A).ToList();
    var idAssembleia = remessaCota.Select(_ => _.IdAssembleia).ToList();

    var parcelas           = await _repo.GetParcelas(request.IdCota, request.Parcela);
    var demonstrativoGrupo = await _repo.GetDemonstrativoGrupo(idAssembleia);
    var remessaMensalVlBoleto = await _repo.GetRemessaMensalVlBoleto(idConco021A);

    var resultado = new List<CobrancasEmitidas>();
    foreach (var cota in remessaCota)
    {
        var parcela = parcelas.FirstOrDefault(_ =>
            _.IdCota == cota.IdCota && _.Parcela == cota.NoParcela);
        var grupo  = demonstrativoGrupo.FirstOrDefault(_ =>
            _.IdAssembleia == cota.IdAssembleia);
        var boleto = remessaMensalVlBoleto
            .Where(_ => _.IdConco021A == cota.IdConco021A).ToList();

        resultado.Add(MapearCobrancasEmitidas(request, cota, parcela, grupo, boleto));
    }
    return resultado;
}

private async Task<List<CobrancasEmitidas>> GetAvulsasSemPaginacao(
    GetCobrancasEmitidasRequest request)
{
    var avulsas = await _repo.GetCobrancasAvulsasTodos(request.IdCota);
    return avulsas
        .Select(a => MapearCobrancasAvulsas(request, a))
        .ToList();
}
```

### 4. Facade — switch final corrigido

```csharp
var ret = request.TipoCobranca switch
{
    "A" => await GetAvulsas(request, numPage, sizePage),
    "T" => await GetTodos(request, numPage, sizePage),
    _   => await GetMensais(request, numPage, sizePage),
};
```

