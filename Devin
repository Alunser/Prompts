Correção 2 — MensagemProcessador.cs
FX9.ProcessaMovimentoContabil.Application/UseCases/Processadores/MensagemProcessador.cs
Substituir o método PublicarRetornosSeExistir por
csharpprivate async Task<bool> PublicarRetornosSeExistir(
    List<RetornoMovimentoContabil> retornosParaPublicar)
{
    if (!retornosParaPublicar.Any()) return true;

    var resultado = await _retornoMovimentoContabilService
        .PublicarEmLote(retornosParaPublicar);

    if (!resultado.Success)
    {
        _logger.LogError(
            "Falha ao publicar retornos. " +
            "Mensagem não será commitada — Kafka irá reenviar.");
        return false;
    }

    return true;
}
Substituir o método ProcessarAsync por
csharppublic async Task ProcessarAsync(
    ConsumeResult<string, RecebimentoMovimentoContabil> consumeResult,
    CancellationToken cancellationToken)
{
    try
    {
        var retornosParaPublicar = new List<RetornoMovimentoContabil>();

        // ✅ Lógica de negócio existente — não alterar
        var resultado = await _handler.ProcessarMensagemIndividual(
            consumeResult,
            retornosParaPublicar,
            cancellationToken);

        // ✅ Verifica se publicação foi bem sucedida antes de commitar
        var publicacaoOk = await PublicarRetornosSeExistir(retornosParaPublicar);

        if (!publicacaoOk)
        {
            // Publicação falhou — não commita → Kafka reenvia para nova tentativa
            _logger.LogWarning(
                "Publicação do retorno falhou. " +
                "Mensagem não commitada — Kafka irá reenviar. " +
                "Offset: {Offset} Partição: {Particao}",
                consumeResult.Offset,
                consumeResult.Partition);
            return;
        }

        if (DeveCommitar(resultado))
            CommitarMensagem(consumeResult);
        else
            LogarErroSemCommit(consumeResult);
    }
    catch (Exception ex)
    {
        // Não commita — Kafka irá reenviar automaticamente
        _logger.LogError(ex,
            "Erro inesperado ao processar mensagem. " +
            "Kafka irá reenviar automaticamente.");
    }
}

