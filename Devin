pythondef handler(event: dict, context) -> dict:
    logger.info(LOG_INICIO.format(lote_id=event.get("loteId")))
    input_data = LoteInput.from_event(event)

    secret_manager_client = SecretManagerClient()
    sts_client = StsTokenClient(secret_manager_client=secret_manager_client)
    contabilizacoes_client = ContabilizacoesClient(sts_client=sts_client)

    conn = get_connection()
    try:
        repo = EventoRepository(conn)
        service = LoteService(repo=repo, contabilizacoes_client=contabilizacoes_client)
        result = service.processar(input_data)
    finally:
        conn.close()

    logger.info(LOG_SUCESSO)
    return result.to_dict()

