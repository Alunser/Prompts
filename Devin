### MovimentoCobrancaConverter.cs
```csharp
public static class MovimentoCobrancaConverter
{
    private static readonly Dictionary<string, List<int>> CodigosPorTipo =
        new Dictionary<string, List<int>>(StringComparer.OrdinalIgnoreCase)
    {
        { "P", new List<int> { 10 } },
        { "L", new List<int> { 410, 420, 430, 610, 620, 630, 1110 } },
        { "A", new List<int> { 810, 1010 } },
        { "Q", new List<int> { 1120 } },
        { "T", new List<int> { 1660,1670,1980,1750,1790,1950,1990,1710,1960,1970 } },
        { "O", new List<int>() }
    };

    public static List<int> ObterCodigosPorTipo(string tipo)
    {
        if (string.IsNullOrEmpty(tipo)) return new List<int>();

        if (tipo.Equals("O", StringComparison.OrdinalIgnoreCase))
            return CodigosPorTipo
                .Where(kvp => !kvp.Key.Equals("O", StringComparison.OrdinalIgnoreCase))
                .SelectMany(kvp => kvp.Value)
                .Distinct()
                .ToList();

        if (CodigosPorTipo.TryGetValue(tipo.ToUpper(), out var codigos))
            return codigos;

        return new List<int>();
    }
}
