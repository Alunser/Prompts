## 5. repositories/lote_repository.py

```python
from __future__ import annotations

import logging
from typing import TYPE_CHECKING

from src.models.enums import StatusProcessamento
from src.utils.constants import (
    SQL_ATUALIZAR_STATUS,
    SQL_BUSCAR_TOTAL_ESPERADO,
    SQL_CONTAR_MOVIMENTOS,
)

if TYPE_CHECKING:
    import pymysql

logger = logging.getLogger(__name__)


class LoteRepository:
    def __init__(self, connection: pymysql.Connection) -> None:
        self.connection = connection

    def buscar_total_esperado(self, lote_id: str) -> int:
        try:
            with self.connection.cursor() as cursor:
                cursor.execute(SQL_BUSCAR_TOTAL_ESPERADO, (lote_id,))
                row = cursor.fetchone()

            if row is None:
                raise ValueError(f"Lote nao encontrado: {lote_id}")

            return row["total_esperado"]

        except ValueError:
            raise
        except Exception as e:
            logger.error(
                "Erro ao buscar total esperado",
                extra={"lote_id": lote_id, "erro": str(e)},
            )
            raise

    def contar_movimentos(self, lote_id: str) -> int:
        try:
            with self.connection.cursor() as cursor:
                cursor.execute(SQL_CONTAR_MOVIMENTOS, (lote_id,))
                row = cursor.fetchone()

            return row["total"] if row else 0

        except Exception as e:
            logger.error(
                "Erro ao contar movimentos",
                extra={"lote_id": lote_id, "erro": str(e)},
            )
            raise

    def atualizar_status(
        self,
        lote_id: str,
        status: StatusProcessamento,
    ) -> None:
        try:
            with self.connection.cursor() as cursor:
                cursor.execute(
                    SQL_ATUALIZAR_STATUS,
                    (status.value, lote_id),
                )
            self.connection.commit()

        except Exception as e:
            logger.error(
                "Erro ao atualizar status do lote",
                extra={
                    "lote_id": lote_id,
                    "status": status.name,
                    "erro": str(e),
                },
            )
            raise
