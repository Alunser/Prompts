## 3. services/lote_service.py — dupla validação

Substituir a implementação COMPLETA do método processar por:

```python
def processar(self, input_data: LoteInput) -> LoteResponse:

    if input_data.tipo == TipoProcessamento.REPROCESSAMENTO:
        logger.info(
            "Reprocessamento solicitado",
            extra={
                "lote_id": input_data.lote_id,
                "data_batch": input_data.data_batch,
            }
        )
        self.contabilizacoes_client.reprocessar(
            lote_id=input_data.lote_id,
            data_batch=input_data.data_batch,
        )

    # 1º check — input vs banco
    total_banco = self.repo.buscar_total_esperado(
        input_data.lote_id
    )

    if input_data.quantidade_total != total_banco:
        logger.error(
            "Divergencia entre quantidade_total do input e banco",
            extra={
                "lote_id": input_data.lote_id,
                "quantidade_total_input": input_data.quantidade_total,
                "quantidade_total_banco": total_banco,
            }
        )
        self.repo.atualizar_status(
            input_data.lote_id,
            StatusProcessamento.VALIDACAO_COM_FALHA,
        )
        return LoteResponse(
            status=StatusProcessamento.VALIDACAO_COM_FALHA.value,
            lote_id=input_data.lote_id,
        )

    # 2º check — COUNT(*) vs quantidade_total
    total_inserido = self.repo.contar_movimentos(
        input_data.lote_id
    )

    logger.info(
        "Verificando contagem do lote",
        extra={
            "lote_id": input_data.lote_id,
            "data_batch": input_data.data_batch,
            "quantidade_total_input": input_data.quantidade_total,
            "quantidade_total_banco": total_banco,
            "total_inserido": total_inserido,
        }
    )

    if total_inserido == input_data.quantidade_total:
        self.repo.atualizar_status(
            input_data.lote_id,
            StatusProcessamento.VALIDACAO_COM_SUCESSO,
        )
        return LoteResponse(
            status=StatusProcessamento.VALIDACAO_COM_SUCESSO.value,
            lote_id=input_data.lote_id,
        )

    self.repo.atualizar_status(
        input_data.lote_id,
        StatusProcessamento.VALIDACAO_COM_FALHA,
    )
    return LoteResponse(
        status=StatusProcessamento.VALIDACAO_COM_FALHA.value,
        lote_id=input_data.lote_id,
    )
```

