Passo 3.4 — Atualizar ContabilizacaoDisponibilizacaoService.cs

Substituir o while(true) por chunks paralelos com SemaphoreSlim.
O restante da classe (construtor, injeções) permanece igual:

csharpprivate const int ChunkSize      = 10_000;
private const int MaxParalelismo = 4;

public async Task ProcessarAsync(
    Guid loteId,
    DateTime dataBatch,
    DateTime dataProcessamento,
    int totalRegistro,
    CancellationToken cancellationToken)
{
    var totalChunks = (int)Math.Ceiling((double)totalRegistro / ChunkSize);

    _logger.LogInformation(
        "CHUNKS_CALCULADOS | TotalChunks={TotalChunks} | ChunkSize={ChunkSize}",
        totalChunks, ChunkSize);

    // SemaphoreSlim: sempre 4 chunks simultâneos
    // Conforme um termina, o próximo entra automaticamente
    var semaphore = new SemaphoreSlim(MaxParalelismo);

    var tasks = Enumerable.Range(0, totalChunks)
        .Select(chunkIndex => ProcessarChunkAsync(
            chunkIndex,
            dataProcessamento,
            dataBatch,
            loteId,
            totalRegistro,
            semaphore,
            cancellationToken));

    await Task.WhenAll(tasks);
}

private async Task ProcessarChunkAsync(
    int chunkIndex,
    DateTime dataProcessamento,
    DateTime dataBatch,
    Guid loteId,
    int totalRegistro,
    SemaphoreSlim semaphore,
    CancellationToken cancellationToken)
{
    await semaphore.WaitAsync(cancellationToken);
    try
    {
        var offset = chunkIndex * ChunkSize;

        _logger.LogInformation(
            "CHUNK_INICIADO | ChunkIndex={ChunkIndex} | Offset={Offset}",
            chunkIndex, offset);

        var contabilizacaoFluirList = (await _contabilizacaoFluirRepository
            .ObterPorOffsetAsync(dataProcessamento, offset, ChunkSize)).ToList();

        if (!contabilizacaoFluirList.Any()) return;

        var idCotaSet  = contabilizacaoFluirList.Select(x => x.IdCota).Distinct().ToArray();
        var idGrupoSet = contabilizacaoFluirList.Select(x => x.IdGrupo).Distinct().ToArray();

        var taskCota  = _cotaRepository.ObterPorAsync(idCotaSet);
        var taskGrupo = _grupoRepository.ObterPorAsync(idGrupoSet);
        await Task.WhenAll(taskCota, taskGrupo);

        var cotaList = (await taskCota)
            .GroupBy(x => x.IdCota)
            .ToDictionary(g => g.Key, g => g.First());

        var grupoList = (await taskGrupo)
            .GroupBy(x => x.IdGrupo)
            .ToDictionary(g => g.Key, g => g.First());

        var eventoContabilizacaoList = contabilizacaoFluirList
            .AsParallel()
            .WithDegreeOfParallelism(10)
            .Select(evento =>
            {
                var cotaDto  = cotaList.TryGetValue(evento.IdCota,   out var cota)  ? cota  : null;
                var grupoDto = grupoList.TryGetValue(evento.IdGrupo, out var grupo) ? grupo : null;
                return EventoContabilizacaoWrapper.Criar(evento, cotaDto, grupoDto);
            })
            .ToList();

        var lote = new LoteWrapper(loteId, dataBatch, totalRegistro);
        foreach (var eventoContabil in eventoContabilizacaoList)
            lote.AdicionarEventoContabilizacao(eventoContabil);

        await _processoContabilizacaoService
            .PublicarContabilizacaoAsync(lote, cancellationToken);

        _logger.LogInformation(
            "CHUNK_CONCLUIDO | ChunkIndex={ChunkIndex} | Eventos={Eventos}",
            chunkIndex, eventoContabilizacaoList.Count);
    }
    catch (Exception ex)
    {
        _logger.LogError(ex,
            "CHUNK_ERRO | ChunkIndex={ChunkIndex} | Erro={Erro}", chunkIndex, ex.Message);
        throw;
    }
    finally
    {
        semaphore.Release();
    }
}

Passo 3.5 — Atualizar ProcessoContabilizacaoService.cs

Substituir TryPublishWithRetryAsync + Task.WhenAll por Produce fire-and-forget + Flush.
Inspirado no padrão da ConciliacaoContabil que publica 1 milhão de registros em 2 segundos:

csharppublic async Task<ICommandResult> PublicarContabilizacaoAsync(
    LoteWrapper loteWrapper,
    CancellationToken stoppingToken)
{
    var topicConfiguration = _kafkaConfiguration.ProducerConfiguration.TopicConfigurations
        .FirstOrDefault(x => x.Tipo == ETipoTopico.ContabilizacaoGerada);

    if (topicConfiguration == null || !topicConfiguration.Enable)
    {
        _logger.LogCritical(
            "LOTE_ABORTADO | Fluxo=PublicarContabilizacao | Motivo=TopicConfigInvalida");
        return new CommandResult(HttpStatusCode.BadRequest.GetHashCode());
    }

    if (loteWrapper.EventosContabilizacoes == null || !loteWrapper.EventosContabilizacoes.Any())
        return new CommandResult(HttpStatusCode.OK.GetHashCode());

    var flushInterval = _kafkaConfiguration.ProducerConfiguration.FlushInterval;
    var totalSucesso  = 0;
    var totalFalha    = 0;
    var count         = 0;

    using var producer = _producerFactory.CreateProducer<ContabilizacaoGerada>(true);

    foreach (var item in loteWrapper.EventosContabilizacoes)
    {
        if (item == null) continue;

        var headers = new Headers { /* igual ao original */ };
        var value   = new ContabilizacaoGerada { /* igual ao original */ };
        var msg     = new Message<string, ContabilizacaoGerada>
        {
            Key       = loteWrapper.Id.ToString(),
            Value     = value,
            Headers   = headers,
            Timestamp = new Timestamp(DateTime.Now)
        };

        // Fire-and-forget — não aguarda confirmação por evento
        producer.Produce(topicConfiguration.Name, msg, deliveryReport =>
        {
            if (deliveryReport.Error.IsError)
            {
                _logger.LogCritical(
                    "FALHA_DEPENDENCIA | Fluxo=PublicacaoKafka | IdEvento={IdEvento} | Erro={Erro}",
                    item.IdEvento, deliveryReport.Error.Reason);
                Interlocked.Increment(ref totalFalha);
            }
            else
            {
                Interlocked.Increment(ref totalSucesso);
            }
        });

        // Flush a cada N eventos — garante entrega em lote
        if (++count % flushInterval == 0)
            producer.Flush(TimeSpan.FromSeconds(30));
    }

    // Flush final — garante entrega dos eventos restantes
    producer.Flush(TimeSpan.FromSeconds(30));

    _logger.LogInformation(
        "KAFKA_PUBLICADO | Fluxo=PublicarContabilizacao | LoteId={LoteId} | Sucesso={Sucesso} | Falha={Falha} | Total={Total}",
        loteWrapper.Id, totalSucesso, totalFalha, loteWrapper.EventosContabilizacoes.Count);

    return new CommandResult(HttpStatusCode.OK.GetHashCode());
}

Remover completamente o método TryPublishWithRetryAsync — não é mais necessário.

Adicionar FlushInterval no appsettings se não existir:

