csharpusing System;
using System.Collections.Generic;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.Extensions.Logging;
using UA2.Consorcio.Domain.Interfaces.Repositories;
using UA2.Consorcio.Domain.Interfaces.Services;
using UA2.Consorcio.Domain.Wrappers;

namespace UA2.Consorcio.Application.Services
{
    public class ContabilizacaoDisponibilizacaoService : IContabilizacaoDisponibilizacaoService
    {
        private const int ChunkSize      = 10_000;
        private const int MaxParalelismo = 4;

        private readonly IContabilizacaoFluirRepository _contabilizacaoFluirRepository;
        private readonly ICotaRepository                _cotaRepository;
        private readonly IGrupoRepository               _grupoRepository;
        private readonly IProcessoContabilizacaoService _processoContabilizacaoService;
        private readonly ILogger<ContabilizacaoDisponibilizacaoService> _logger;

        public ContabilizacaoDisponibilizacaoService(
            IContabilizacaoFluirRepository contabilizacaoFluirRepository,
            ICotaRepository                cotaRepository,
            IGrupoRepository               grupoRepository,
            IProcessoContabilizacaoService processoContabilizacaoService,
            ILogger<ContabilizacaoDisponibilizacaoService> logger)
        {
            _contabilizacaoFluirRepository = contabilizacaoFluirRepository;
            _cotaRepository                = cotaRepository;
            _grupoRepository               = grupoRepository;
            _processoContabilizacaoService = processoContabilizacaoService;
            _logger                        = logger;
        }

        public async Task ProcessarAsync(
            Guid loteId,
            DateTime dataBatch,
            DateTime dataProcessamento,
            int totalRegistro,
            CancellationToken cancellationToken)
        {
            // 1. Busca MIN e MAX do dia
            var range = await _contabilizacaoFluirRepository
                .ObterRangeIdsAsync(dataProcessamento);

            _logger.LogInformation(
                "RANGE_OBTIDO | IdMin={IdMin} | IdMax={IdMax}",
                range.IdMin, range.IdMax);

            // 2. Divide em N fatias — uma por paralelo
            var fatias = DividirEmFatias(range.IdMin, range.IdMax, MaxParalelismo);

            // 3. Cada fatia roda em paralelo com seu próprio cursor interno
            var tasks = fatias.Select(fatia => ProcessarFatiaAsync(
                fatia.IdInicio,
                fatia.IdFim,
                dataProcessamento,
                dataBatch,
                loteId,
                totalRegistro,
                cancellationToken));

            await Task.WhenAll(tasks);
        }

        private static IEnumerable<(long IdInicio, long IdFim)> DividirEmFatias(
            long idMin, long idMax, int totalFatias)
        {
            var tamanhoFatia = (long)Math.Ceiling((double)(idMax - idMin + 1) / totalFatias);

            for (var i = 0; i < totalFatias; i++)
            {
                var inicio = idMin + (i * tamanhoFatia);
                var fim    = Math.Min(inicio + tamanhoFatia - 1, idMax);
                if (inicio > idMax) break;
                yield return (inicio, fim);
            }
        }

        private async Task ProcessarFatiaAsync(
            long idInicio,
            long idFim,
            DateTime dataProcessamento,
            DateTime dataBatch,
            Guid loteId,
            int totalRegistro,
            CancellationToken cancellationToken)
        {
            // Cursor começa antes do primeiro ID da fatia
            var ultimoIdEvento = idInicio - 1;

            _logger.LogInformation(
                "FATIA_INICIADA | IdInicio={IdInicio} | IdFim={IdFim}",
                idInicio, idFim);

            while (true)
            {
                // Cursor avança pelo último ID — tempo constante, usa índice
                var lista = (await _contabilizacaoFluirRepository.ObterPorFatiaAsync(
                    dataProcessamento,
                    ultimoIdEvento,
                    idFim,
                    ChunkSize)).ToList();

                if (!lista.Any()) break;

                ultimoIdEvento = lista.Last().IdEvento;

                var idCotaSet  = lista.Select(x => x.IdCota).Distinct().ToArray();
                var idGrupoSet = lista.Select(x => x.IdGrupo).Distinct().ToArray();

                var taskCota  = _cotaRepository.ObterPorAsync(idCotaSet);
                var taskGrupo = _grupoRepository.ObterPorAsync(idGrupoSet);
                await Task.WhenAll(taskCota, taskGrupo);

                var cotaList = (await taskCota)
                    .GroupBy(x => x.IdCota)
                    .ToDictionary(g => g.Key, g => g.First());

                var grupoList = (await taskGrupo)
                    .GroupBy(x => x.IdGrupo)
                    .ToDictionary(g => g.Key, g => g.First());

                var eventoContabilizacaoList = lista
                    .AsParallel()
                    .WithDegreeOfParallelism(10)
                    .Select(evento =>
                    {
                        var cotaDto  = cotaList.TryGetValue(evento.IdCota,   out var cota)  ? cota  : null;
                        var grupoDto = grupoList.TryGetValue(evento.IdGrupo, out var grupo) ? grupo : null;
                        return EventoContabilizacaoWrapper.Criar(evento, cotaDto, grupoDto);
                    })
                    .ToList();

                var lote = new LoteWrapper(loteId, dataBatch, totalRegistro);
                foreach (var eventoContabil in eventoContabilizacaoList)
                    lote.AdicionarEventoContabilizacao(eventoContabil);

                await _processoContabilizacaoService
                    .PublicarContabilizacaoAsync(lote, cancellationToken);

                _logger.LogInformation(
                    "FATIA_PAGINA | UltimoId={UltimoId} | LimiteFatia={LimiteFatia} | Eventos={Eventos}",
                    ultimoIdEvento, idFim, eventoContabilizacaoList.Count);
            }

            _logger.LogInformation(
                "FATIA_CONCLUIDA | IdInicio={IdInicio} | IdFim={IdFim}",
                idInicio, idFim);
        }
    }
}

