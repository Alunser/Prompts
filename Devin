        List<int> id_cota, short? parcela)
    {
        var query = _dbContext.VwTaAclParcelas.AsQueryable();
        query = query.Where(_ => id_cota.Contains(_.IdCota));
        if (parcela.HasValue)
            query = query.Where(_ => _.Parcela == parcela);
        return await query.AsNoTracking().ToListAsync();
    }

    public async Task<List<VwTaAclRemessaMensalCota>> GetRemessaMensalCota(
        List<int> id_cota, short? parcela, int numPage, int sizePage)
    {
        int pular = (numPage - 1) * sizePage;
        var query = _dbContext.VwTaAclRemessaMensalCota.AsQueryable();
