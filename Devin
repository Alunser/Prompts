## 4. services/lote_service.py

Substituir implementação COMPLETA por:

```python
import logging

from src.clients.external.contabilizacoes_client import ContabilizacoesClient
from src.models.enums import StatusProcessamento, TipoProcessamento
from src.models.lote_input import LoteInput
from src.models.lote_response import LoteResponse
from src.repositories.lote_repository import LoteRepository

logger = logging.getLogger(__name__)


class LoteService:
    def __init__(
        self,
        repo: LoteRepository,
        contabilizacoes_client: ContabilizacoesClient,
    ) -> None:
        self.repo = repo
        self.contabilizacoes_client = contabilizacoes_client

    def processar(self, input_data: LoteInput) -> LoteResponse:
        if input_data.tipo == TipoProcessamento.REPROCESSAMENTO:
            return self._disparar_reprocessamento(input_data)
        return self._validar_lote(input_data)

    def _disparar_reprocessamento(
        self, input_data: LoteInput
    ) -> LoteResponse:
        logger.info(
            "Disparando reprocessamento",
            extra={
                "lote_id": input_data.lote_id,
                "data_batch": input_data.data_batch,
            },
        )
        self.contabilizacoes_client.reprocessar(
            lote_id=input_data.lote_id,
            data_batch=input_data.data_batch,
        )
        return self._criar_resposta(
            input_data.lote_id,
            StatusProcessamento.AGUARDANDO_REPROCESSAMENTO,
        )

    def _validar_lote(self, input_data: LoteInput) -> LoteResponse:
        total_banco = self.repo.buscar_total_esperado(input_data.lote_id)
        total_inserido = self.repo.contar_movimentos(input_data.lote_id)

        logger.info(
            "Validando lote",
            extra={
                "lote_id": input_data.lote_id,
                "quantidade_total_input": input_data.quantidade_total,
                "quantidade_total_banco": total_banco,
                "total_inserido": total_inserido,
            },
        )

        validacao_ok = (
            input_data.quantidade_total == total_banco
            and total_inserido == input_data.quantidade_total
        )

        status = (
            StatusProcessamento.VALIDACAO_COM_SUCESSO
            if validacao_ok
            else StatusProcessamento.VALIDACAO_COM_FALHA
        )

        return self._criar_resposta(input_data.lote_id, status)

    def _criar_resposta(
        self,
        lote_id: str,
        status: StatusProcessamento,
    ) -> LoteResponse:
        self.repo.atualizar_status(lote_id, status)
        logger.info(
            "Status do lote atualizado",
            extra={
                "lote_id": lote_id,
                "status": status.name,
                "codigo": status.value,
            },
        )
        return LoteResponse(
            status=status.value,
            lote_id=lote_id,
        )
