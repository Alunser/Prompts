csharppublic class DisponibilizarContabilizacaoWorkerHandler
    : IRequestHandler<DisponibilizarContabilizacaoWorkerCommand, ICommandResult>
{
    private readonly IContabilizacaoDisponibilizacaoService _disponibilizacaoService;
    private readonly IProcessoBatchService                  _processoBatchService;
    private readonly IContabilizacaoFluirRepository         _contabilizacaoFluirRepository;
    private readonly ILogger<DisponibilizarContabilizacaoWorkerHandler> _logger;

    public DisponibilizarContabilizacaoWorkerHandler(
        IContabilizacaoDisponibilizacaoService disponibilizacaoService,
        IProcessoBatchService                  processoBatchService,
        IContabilizacaoFluirRepository         contabilizacaoFluirRepository,
        ILogger<DisponibilizarContabilizacaoWorkerHandler> logger)
    {
        _disponibilizacaoService       = disponibilizacaoService;
        _processoBatchService          = processoBatchService;
        _contabilizacaoFluirRepository = contabilizacaoFluirRepository;
        _logger                        = logger;
    }

    public async Task<ICommandResult> Handle(
        DisponibilizarContabilizacaoWorkerCommand request,
        CancellationToken cancellationToken)
    {
        // 1. Consome do Kafka — DataProcessamento e DataBatch vêm daqui
        var resultConsumirMensagem = await _processoBatchService
            .ConsumirMensagem(cancellationToken);

        if (!resultConsumirMensagem.Success)
        {
            var errorResult = new CommandResult(resultConsumirMensagem.StatusCode);
            errorResult.AddNotifications((CommandResult)resultConsumirMensagem);
            return errorResult;
        }

        var commandResult = new CommandResult(HttpStatusCode.Accepted.GetHashCode());
        var processoBatchCommandResult =
            (ObterStatusExecucaoCommandResult)resultConsumirMensagem;

        var totalRegistro = await _contabilizacaoFluirRepository
            .ObterTotalLinhasAsync(processoBatchCommandResult.DataProcessamento);

        using var logCtx = new LogLoteContext(
            request.Id, processoBatchCommandResult.DataBatch, "WORKER", totalRegistro);

        _logger.LogInformation(
            "LOTE_INICIADO | Fluxo=Handle | TotalRegistros={TotalRegistros}", totalRegistro);

        if (totalRegistro == 0)
        {
            _logger.LogInformation("LOTE_CONCLUIDO | Fluxo=Handle | TotalRegistros=0");
            return commandResult;
        }

        _logger.LogInformation(
            "CONSULTA_REALIZADA | Fluxo=Handle | TotalRegistros={TotalRegistros}", totalRegistro);

        // 2. Delega ao serviço — DataProcessamento e DataBatch vêm do Kafka
        await _disponibilizacaoService.ProcessarAsync(
            request.Id,
            processoBatchCommandResult.DataBatch,
            processoBatchCommandResult.DataProcessamento,
            totalRegistro,
            cancellationToken);

        return commandResult;
    }
}


