3. KafkaConsumerChannel.cs — absorver lógica do produtor
Substituir o conteúdo completo pelo código abaixo:
csharp// FX9.ProcessaMovimentoContabil.Infra.Messaging
// Consumers/KafkaConsumerChannel.cs

namespace FX9.ProcessaMovimentoContabil.Infra.Messaging.Consumers;

public class KafkaConsumerChannel : IKafkaConsumerChannel
{
    private readonly IKafkaConsumerFactory _kafkaConsumerFactory;
    private readonly ILogger<KafkaConsumerChannel> _logger;

    private IConsumer<string, RecebimentoMovimentoContabil> _consumer;

    public KafkaConsumerChannel(
        IKafkaConsumerFactory kafkaConsumerFactory,
        ILogger<KafkaConsumerChannel> logger)
    {
        _kafkaConsumerFactory = kafkaConsumerFactory;
        _logger = logger;
    }

    public void Inicializar(string nomeTopico)
    {
        _consumer = _kafkaConsumerFactory
            .CreateConsumer<RecebimentoMovimentoContabil>(useAvroDeserializer: true);

        _consumer.Subscribe(nomeTopico);

        _logger.LogInformation(
            "Consumer Kafka inicializado. Tópico: {Topico}", nomeTopico);
    }

    public async Task ProduzirParaChannelAsync(
        ChannelWriter<ConsumeResult<string, RecebimentoMovimentoContabil>> channelWriter,
        CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                try
                {
                    var mensagem = _consumer.Consume(cancellationToken);

                    if (mensagem is null) continue;

                    await channelWriter.WriteAsync(mensagem, cancellationToken);
                }
                catch (ConsumeException ex)
                    when (ex.Error.Code == ErrorCode.UnknownTopicOrPart)
                {
                    _logger.LogWarning(
                        "Tópico ainda não disponível. " +
                        "Tentando novamente em 2 segundos.");

                    await Task.Delay(2000, cancellationToken);
                }
                catch (ConsumeException ex)
                {
                    _logger.LogError(ex,
                        "Erro ao consumir mensagem do Kafka. Continuando...");
                }
            }
        }
        catch (OperationCanceledException)
        {
            _logger.LogInformation("Leitura do Kafka encerrada.");
        }
        finally
        {
            channelWriter.Complete();
        }
    }

    public void CommitarMensagem(
        ConsumeResult<string, RecebimentoMovimentoContabil> consumeResult)
        => _consumer.Commit(consumeResult);

    public void Encerrar()
    {
        _consumer.Close();
        _logger.LogInformation("Consumer Kafka encerrado.");
    }
}

